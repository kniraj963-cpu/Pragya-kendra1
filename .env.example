# MONGODB_URI: MongoDB connection string (e.g., MongoDB Atlas or local mongod).
# When omitted in local preview, the server falls back to an in-process/server store.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="pragya_kendra_ranchi"

# Optional MongoDB Atlas MCP Service Account configuration
MDB_MCP_API_CLIENT_ID="mdb_sa_id_your_client_id"
MDB_MCP_API_CLIENT_SECRET="mdb_sa_sk_your_client_secret"
MDB_MCP_API_BASE_URL="https://mcp.mongodb.com"

# STAFF_ACCESS_PIN: Server-verified Staff Operations PIN (defaults to 9999 in demo if unset)
STAFF_ACCESS_PIN="9999"
STAFF_ADMIN_PASSWORD="your-strong-staff-password"
STAFF_SESSION_SECRET="replace-with-random-secret-hex"

# VITE_API_BASE_URL: Optional external Express API base URL when frontend is deployed to Cloudflare Pages
VITE_API_BASE_URL=""

# VITE_SITE_URL / APP_URL: Canonical custom domain URL (add when ready, e.g. https://pragyakendraranchi.in)
VITE_SITE_URL=""
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Cloudflare Pages CLI deployment (optional)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
